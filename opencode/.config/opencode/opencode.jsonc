{
    "$schema": "https://opencode.ai/config.json",
    "permissions": [
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "ask" },
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "shell", "resource": "git --help *", "effect": "allow" },
        { "action": "shell", "resource": "git status *", "effect": "allow" },
        { "action": "shell", "resource": "git diff *", "effect": "allow" },
        { "action": "shell", "resource": "git grep *", "effect": "allow" },
        { "action": "shell", "resource": "git log *", "effect": "allow" },
        { "action": "shell", "resource": "git show *", "effect": "allow" },
        { "action": "shell", "resource": "ls *", "effect": "allow" },
        { "action": "shell", "resource": "find *", "effect": "allow" },
        { "action": "shell", "resource": "cat *", "effect": "allow" },
        { "action": "shell", "resource": "file *", "effect": "allow" },
        { "action": "shell", "resource": "grep *", "effect": "allow" },
        { "action": "shell", "resource": "jq *", "effect": "allow" },
        { "action": "shell", "resource": "sort *", "effect": "allow" },
        { "action": "shell", "resource": "head *", "effect": "allow" },
        { "action": "shell", "resource": "sed -n *", "effect": "allow" },
        { "action": "shell", "resource": "pwd", "effect": "allow" }
    ],
    "plugins": [
        // "~/develop/plugins/subagent",
        "@plannotator/opencode@latest"
    ],
    "mcp": {
        "servers": {
            "chrome-devtools": {
                "type": "local",
                // "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--no-usage-statistics", "--no-performance-crux", "-e", "/usr/bin/chromium"],
                "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--executable-path=/usr/bin/brave"],
                "environment": {
                    "CHROME_DEVTOOLS_MCP_NO_UPDATE_CHECKS": "1"
                }
            },
            "drawio": {
              "type": "local",
              "command": [ "npx", "-y", "@drawio/mcp" ]
            },
            // Needs FigCraft running with: figcraft --control 7979
            "figcraft": {
              "type": "local",
              "command": ["figcraft-cli", "mcp", "--attach", "7979"]
            }
        }
    },
    "shell": "/usr/bin/zsh",
    "experimental": {
        "todo": true,
        "image_generate": {
            // "model": "openai/gpt-image-2"
            "model": "openai/gpt-image-2.6-sunburst"
        }
    },
    "providers": {
        "openai": {
            "models": {
                "gpt-6-astra": { "limit": { "context": 1050000, "input": 922000, "output": 128000 } },
                "gpt-6-luna": { "limit": { "context": 1050000, "input": 922000, "output": 128000 } }
            }
        },
        "ollama": {
            "package": "aisdk:@ai-sdk/openai-compatible",
            "name": "Ollama (local)",
            "settings": {
                "baseURL": "http://localhost:11434/v1"
            },
            "models": {
                "gpt-oss:latest": {
                    "name": "GPT-oss",
                    "reasoning": true,
                    "settings": {
                        "reasoningEffort": "high",
                        "textVerbosity": "low",
                        "reasoningSummary": "auto",
                        "include": [
                            "reasoning.encrypted_content"
                        ]
                    }
                },
                "gemma4:12b-32k": {
                    "name": "gemma4:12b-32k",
                    "modelID": "gemma4:12b-32k",
                    "capabilities": {
                        "tools": true
                    },
                    "settings": {
                        "temperature": 0.1
                    }
                }
            }
        }
    }
}
