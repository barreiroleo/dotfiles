{
  "theme": {
    "name": "opencode",
    "mode": "system"
  },
  "diffs": {
    "wrap": "word",
    "view": "unified",
    "single": false,
    "fullscreen": false
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": true,
    "thinking": "hide",
    "grouping": "auto",
    "markdown": "rendered",
    "verbosity": "low",
    "image_preview": true,
    "tps": true,
    "permissions": "prompt"
  },
  "animations": true,
  "debug": {
    "turn_tokens": true,
    "devtools": true,
    "timing": false
  },
  "attention": {
    "enabled": true,
    "notifications": true,
    "sound": true,
    "volume": 1
  },
  "prompt": {
    "paste": "compact",
    "image_preview": true
  },
  "tabs": {
    "layout": "horizontal",
    "scope": "cwd",
    "mode": "auto",
    "indicators": "status"
  },
  "terminal": {
    "title": true
  },
  "plugins": [
    "opencode-vim@latest",
    "~/develop/plugins/opencode-annotate"
  ]
}
