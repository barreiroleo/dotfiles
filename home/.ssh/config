Host *
    SetEnv TERM=xterm-256color
    ServerAliveInterval 120
    ForwardX11 yes
    Compression yes
    # Multiplexes connections so Docker doesn't open a new SSH channel every second
    #   rm -f ~/.ssh/sockets/* && mkdir -p ~/.ssh/sockets && chmod 700 ~/.ssh/sockets
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%C
    ControlPersist 15m

Include ~/.ssh/config.prod

# ssh-copy-id -i ~/.ssh/id_ed25519.pub lbarreiro-docker
Host lbarreiro-docker
    User lbarreiro
    HostName 192.168.0.1

Host lbarreiro-libvirt
    User lbarreiro
    HostName 192.168.122.41

Host lbarreiro-workstation
    User lbarreiro
    Hostname xx.xxx.x.xxx
    LocalForward 9090 localhost:9090
    # NoMachine port forwarding
    # LocalForward 4003 localhost:4000
    IdentityFile ~/.ssh/id_ed25519
    ForwardAgent yes
    # Refresh every 2 minutes up to 30 tries. ~= 1hr
    # ServerAliveInterval 120
    # ServerAliveCountMax 30
