// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  // Behavior
  "markdown_preview": {
    "limit_content_width": false
  },
  "preferred_line_length": 120,
  "document_symbols": "on",
  "code_lens": "menu",
  "vim_mode": true,
  "vim": {
    "use_smartcase_find": true,
    "toggle_relative_line_numbers": true
  },

  // Fonts
  "terminal": {
    "font_family": "IoskeleyMono Nerd Font"
  },
  "buffer_font_family": "IoskeleyMono Nerd Font",
  "buffer_font_size": 14.0,
  "buffer_line_height": "standard",
  "ui_font_size": 16,

  // Visuals
  "semantic_tokens": "combined",
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "theme": {
    "mode": "system",
    "light": "Gruvbox Material",
    "dark": "Vague"
  },

  // Layout
  "diff_view_style": "unified",
  "git_panel": { "group_by": "none",
                 "tree_view": true,
                 "dock": "left" },
  "debugger": { "dock": "left" },
  "outline_panel": { "dock": "left" },
  "project_panel": { "git_status_indicator": true,
                     "diagnostic_badges": true,
                     "entry_spacing": "comfortable",
                     "dock": "left" },

  // Agents
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "agent_servers": {
    "opencode": {
      "type": "registry"
    },
    "OpenCode2": {
      "favorite_config_option_values": {
        "mode": [
          "implement-simple"
        ],
        "model": [
          "opencode-go/gpt-5.6-luna"
        ],
        "effort": [
          "high"
        ]
      },
      "default_config_options": {
        "mode": "implement-simple",
        "effort": "high",
        "model": "opencode-go/gpt-5.6-luna"
      },
      "type": "custom",
      "command": "opencode2",
      "args": ["acp"]
    }
  },

  // Telemetry
  "edit_predictions": {
    "allow_data_collection": "no"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false,
  },
}
