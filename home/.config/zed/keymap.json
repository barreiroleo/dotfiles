// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "unbind": {
      "ctrl-alt-l": "lsp_tool::ToggleMenu"
    }
  },

  // Works outside of typing. Like a proper vim normal mode. E.g.:
  //   "<leader>e": Toggle the explorer no matter where the cursor is. Meanwhile you're not typing, it'll work.
  // Note: If some context breaks, check which one and add it to the list.
  {"context":"!((Editor && (mode == single_line || vim_mode == insert)) || Terminal || search)",
    "use_key_equivalents":true,
    "bindings": {
      // ",":"dev::OpenKeyContextView",
      ", e": "workspace::ToggleLeftDock",
      ", f g": "text_finder::Toggle",
      ", f f": "file_finder::Toggle",
      ", .": "buffer_search::Deploy",
      ", b d": "workspace::CloseItemInAllPanes",
      "g h": "git::ToggleStaged",
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-alt-l": [
        "agent::NewExternalAgentThread",
        { "agent": "OpenCode2" } // Must be configured in settings.json
      ]
    },
  },
]
