alias vim=nvim
alias vimn="NVIM_APPNAME=nvim-native nvim"

alias zshconf="nvim ~/.zshrc"
alias tmuxconf="cd ~/.config/tmux/"
alias nvimconf="cd ~/.config/nvim/"
alias wezconf="cd ~/dotfiles/home/.config/wezterm/"
alias ghostconf="nvim ~/.config/ghostty/config"

alias excalidraw='docker run --rm -dit --name excalidraw -p 5000:80 excalidraw/excalidraw:latest && echo http://localhost:5000/'
alias plantuml="java -jar ~/.local/bin/plantuml.jar"
function plantuml_gui() {
    run-disown java -jar "$HOME/.local/bin/plantuml.jar" -gui "$PWD"
}
alias cursor="run-disown-silence /opt/cursor/cursor.appimage --no-sandbox"
# Opens the control port that the opencode figcraft MCP server attaches to
alias figcraft="run-disown-silence figcraft --control 7979"

if command -v lsd &> /dev/null; then
    alias ls='lsd --color=auto --group-dirs=first -F'
else
    alias ls='ls --color=auto --group-directories-first -F'
fi
alias ll='ls -lhF'
alias la='ls -lhavF'

# Git: checkout fuzzy, log alias
alias gcof='git branch --sort=committerdate --verbose | fzf --height=20% --reverse --info=inline | awk '\''{print $1}'\'' | xargs --no-run-if-empty git checkout'
alias glg='git log-gph'
alias lg='lazygit'

if command -v bat &> /dev/null; then
    alias cat='bat'
elif command -v batcat &> /dev/null; then
    alias cat='batcat'
fi

alias cleanup='bash "$HOME/.config/cleanup.sh"'

function niri-monitor-off() {
    local -x NIRI_SOCKET=${NIRI_SOCKET:-$(print -r -- /run/user/$UID/niri.*.sock(N[1]))}
    niri msg action power-off-monitors
}
function niri-monitor-on() {
    local -x NIRI_SOCKET=${NIRI_SOCKET:-$(print -r -- /run/user/$UID/niri.*.sock(N[1]))}
    niri msg action power-on-monitors
}
function niri-monitor-blink() {
    niri-monitor-off && niri-monitor-on
}

# Nvidia graphics alias
if command -v cardwire &> /dev/null; then
    NVIDIA_CARDWIRE_ID=$(cardwire list | grep NVIDIA | awk '{print $1}')
    alias nvidia-get-mode="cardwire get"
    alias nvidia-set-integrated="cardwire set integrated"
    alias nvidia-set-hybrid="cardwire set hybrid"
    alias nvidia-launch-cmd="cardwire launch"
    alias nvidia-get-in-use="cardwire gpu ${NVIDIA_CARDWIRE_ID} --lsof"
fi
